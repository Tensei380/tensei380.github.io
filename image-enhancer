<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Image Enhancer</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      padding: 32px 16px;
      color: #f4f4f5;
      background: #101114;
      font: 16px system-ui, sans-serif;
    }

    main { width: min(900px, 100%); margin: 0 auto; }

    h1 { margin-bottom: 8px; }
    .subtext { color: #aaa; margin-top: 0; }

    .panel {
      margin-top: 24px;
      padding: 20px;
      border: 1px solid #333640;
      border-radius: 16px;
      background: #191b20;
    }

    .preview {
      min-height: 280px;
      display: grid;
      place-items: center;
      overflow: hidden;
      border: 1px dashed #555;
      border-radius: 12px;
      background: #111216;
    }

    canvas {
      display: none;
      max-width: 100%;
      max-height: 65vh;
      object-fit: contain;
    }

    #placeholder { padding: 24px; color: #aaa; text-align: center; }

    .controls {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 18px;
      margin-top: 20px;
    }

    label { display: block; margin-bottom: 7px; }
    input[type="range"] { width: 100%; accent-color: #b7f36b; }

    .buttons { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }

    button, .upload {
      display: inline-block;
      padding: 11px 16px;
      border: 0;
      border-radius: 9px;
      color: #17200c;
      background: #b7f36b;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    button:disabled { opacity: .5; cursor: not-allowed; }
    #fileInput { display: none; }
    #status { min-height: 24px; color: #aaa; font-size: 14px; }
  </style>
</head>
<body>
  <main>
    <h1>Image Enhancer</h1>
    <p class="subtext">Choose an image, adjust it, then download the enhanced version.</p>

    <section class="panel">
      <div class="preview">
        <p id="placeholder">Choose an image to get started.</p>
        <canvas id="canvas"></canvas>
      </div>

      <input id="fileInput" type="file" accept="image/*">

      <div class="controls">
        <div>
          <label for="brightness">Brightness: <span id="brightnessValue">100%</span></label>
          <input id="brightness" type="range" min="50" max="150" value="100">
        </div>
        <div>
          <label for="contrast">Contrast: <span id="contrastValue">100%</span></label>
          <input id="contrast" type="range" min="50" max="160" value="100">
        </div>
        <div>
          <label for="saturation">Saturation: <span id="saturationValue">100%</span></label>
          <input id="saturation" type="range" min="0" max="180" value="100">
        </div>
      </div>

      <div class="buttons">
        <label class="upload" for="fileInput">Choose image</label>
        <button id="resetButton" type="button" disabled>Reset</button>
        <button id="downloadButton" type="button" disabled>Download image</button>
      </div>

      <p id="status" role="status">Your image stays on your device; it is not uploaded.</p>
    </section>
  </main>

  <script>
    const fileInput = document.getElementById("fileInput");
    const canvas = document.getElementById("canvas");
    const context = canvas.getContext("2d");
    const placeholder = document.getElementById("placeholder");
    const resetButton = document.getElementById("resetButton");
    const downloadButton = document.getElementById("downloadButton");
    const status = document.getElementById("status");

    const sliders = ["brightness", "contrast", "saturation"].map(id =>
      document.getElementById(id)
    );

    let image = null;
    let fileName = "enhanced-image";

    function updatePreview() {
      if (!image) return;

      context.clearRect(0, 0, canvas.width, canvas.height);
      context.filter = [
        `brightness(${sliders[0].value}%)`,
        `contrast(${sliders[1].value}%)`,
        `saturate(${sliders[2].value}%)`
      ].join(" ");

      context.drawImage(image, 0, 0);
      context.filter = "none";
    }

    fileInput.addEventListener("change", () => {
      const file = fileInput.files[0];
      if (!file) return;

      if (!file.type.startsWith("image/")) {
        status.textContent = "Please choose an image file.";
        return;
      }

      const imageUrl = URL.createObjectURL(file);
      const newImage = new Image();

      newImage.onload = () => {
        image = newImage;
        fileName = file.name.replace(/\.[^.]+$/, "") || "enhanced-image";

        canvas.width = image.naturalWidth;
        canvas.height = image.naturalHeight;
        canvas.style.display = "block";
        placeholder.style.display = "none";

        resetButton.disabled = false;
        downloadButton.disabled = false;
        updatePreview();
        status.textContent = `Image loaded: ${image.naturalWidth} × ${image.naturalHeight}`;
        URL.revokeObjectURL(imageUrl);
      };

      newImage.onerror = () => {
        status.textContent = "Could not open that image. Please try another.";
        URL.revokeObjectURL(imageUrl);
      };

      newImage.src = imageUrl;
    });

    sliders.forEach(slider => {
      slider.addEventListener("input", () => {
        document.getElementById(`${slider.id}Value`).textContent =
          `${slider.value}%`;
        updatePreview();
      });
    });

    resetButton.addEventListener("click", () => {
      sliders.forEach(slider => {
        slider.value = slider.defaultValue;
        document.getElementById(`${slider.id}Value`).textContent =
          `${slider.value}%`;
      });
      updatePreview();
      status.textContent = "Adjustments reset.";
    });

    downloadButton.addEventListener("click", () => {
      if (!image) return;

      canvas.toBlob(blob => {
        if (!blob) {
          status.textContent = "Could not create the image download.";
          return;
        }

        const link = document.createElement("a");
        const url = URL.createObjectURL(blob);

        link.href = url;
        link.download = `${fileName}-enhanced.png`;
        link.click();

        URL.revokeObjectURL(url);
        status.textContent = "Enhanced image downloaded.";
      }, "image/png");
    });
  </script>
</body>
</html>
